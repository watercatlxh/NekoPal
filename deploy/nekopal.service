[Unit]
Description=NekoPal personal assistant daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust the path to the checkout: the daemon runs the built gateway entrypoint.
ExecStart=/usr/bin/env node %h/NekoPal/packages/gateway/dist/main.js
EnvironmentFile=%h/.nekopal/env
Restart=on-failure
RestartSec=5
# The daemon writes only inside its data directory and the workspace it was configured with.
WorkingDirectory=%h
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
